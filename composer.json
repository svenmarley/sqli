{
    "name": "sqli/sqli",
    "description": "Terminal-based interactive MySQL client with a fast custom differential renderer.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "Sqli2\\": "src/"
        },
        "files": [
            "includes/my.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}