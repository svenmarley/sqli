# Runtime state and logs written by the app (per-user; never commit)
/debug.log
/php_errors.log

# .sqli/ config dir. Convention: a file with `.example.` in its name is part of
# the release and is tracked; everything else here is local-only — your real
# config, credentials, state and formatting, plus any themes you drop into
# .sqli/themes/ yourself. The one exception is the single scheme that ships
# with sqli, .sqli/themes/nord.yaml (Nord, unmodified from
# tinted-theming/schemes) — named plainly, because a theme's name is its
# filename stem and a picker offering `nord.example` would be this convention
# leaking into the UI.
.sqli/*
!.sqli/*.example.*
!.sqli/themes/
.sqli/themes/*
!.sqli/themes/nord.yaml

# Legacy sqli file names (pre-2.30.4; auto-migrated into .sqli/ on run)
sqli.json
credentials.json
.sqli.json
.sqli_formatting.json

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
